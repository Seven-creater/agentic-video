  "audio_draft": [
    {
      "id": "ad_01",
      "text": "雪山顶上那件救命包裹，是阿宝亲手送到的。",
      "voice": "Ethan",
      "mode": "narration",
      "segment_ids": [
        "seg_1"
      ],
      "start_s": 0.2,
      "end_s": 2.8
    },
    {
      "id": "ad_02",
      "text": "这一送，惊动了整个快递江湖。",
      "voice": "Ethan",
      "mode": "narration",
      "segment_ids": [
        "seg_2",
        "seg_3"
      ],
      "start_s": 6.2,
      "end_s": 8.6
    },
    {
      "id": "ad_03",
      "text": "阿宝！",
      "voice": "Cherry",
      "mode": "dialogue",
      "speaker": {
        "window_id": "window_83e13a52f7e5c6e6",
        "role_id": "GOOSE"
      },
      "segment_ids": [
        "seg_4"
      ],
      "start_s": 11.2,
      "end_s": 12.0
    },
    {
      "id": "ad_04",
      "text": "雪山急件，真是你冒雪送到的？",
      "voice": "Cherry",
      "mode": "dialogue",
      "speaker": {
        "window_id": "window_83e13a52f7e5c6e6",
        "role_id": "GOOSE"
      },
      "segment_ids": [
        "seg_4"
      ],
      "start_s": 12.2,
      "end_s": 14.6
    },
    {
      "id": "ad_05",
      "text": "是我！",
      "voice": "Ethan",
      "mode": "dialogue",
      "speaker": {
        "window_id": "window_83e13a52f7e5c6e6",
        "role_id": "A"
      },
      "segment_ids": [
        "seg_5"
      ],
      "start_s": 15.2,
      "end_s": 16.0
    },
    {
      "id": "ad_06",
      "text": "箱子在，命就在！",
      "voice": "Ethan",
      "mode": "dialogue",
      "speaker": {
        "window_id": "window_83e13a52f7e5c6e6",
        "role_id": "A"
      },
      "segment_ids": [
        "seg_5"
      ],
      "start_s": 16.4,
      "end_s": 18.2
    },
    {
      "id": "ad_07",
      "text": "顺丰国际，正缺你这样的人。",
      "voice": "Moon",
      "mode": "dialogue",
      "speaker": {
        "window_id": "window_e780e48d993fff89",
        "role_id": "B"
      },
      "segment_ids": [
        "seg_6"
      ],
      "start_s": 19.2,
      "end_s": 21.2
    },
    {
      "id": "ad_08",
      "text": "跟我干，别再被时效拖累。",
      "voice": "Moon",
      "mode": "dialogue",
      "speaker": {
        "window_id": "window_e780e48d993fff89",
        "role_id": "B"
      },
      "segment_ids": [
        "seg_6"
      ],
      "start_s": 21.6,
      "end_s": 23.6
    },
    {
      "id": "ad_09",
      "text": "客户还在等我——走！",
      "voice": "Ethan",
      "mode": "dialogue",
      "speaker": {
        "window_id": "window_e780e48d993fff89",
        "role_id": "A"
      },
      "segment_ids": [
        "seg_6"
      ],
      "start_s": 24.0,
      "end_s": 25.6
    },
    {
      "id": "ad_10",
      "text": "我是时效慢！",
      "voice": "Serena",
      "mode": "dialogue",
      "speaker": {
        "window_id": "window_2388126cb02bbc19",
        "role_id": "TAILUNG"
      },
      "segment_ids": [
        "seg_7"
      ],
      "start_s": 24.2,
      "end_s": 25.8
    },
    {
      "id": "ad_11",
      "text": "让开！",
      "voice": "Moon",
      "mode": "dialogue",
      "speaker": {
        "window_id": "window_214d5101ce730ca9",
        "role_id": "TIGRESS"
      },
      "segment_ids": [
        "seg_8"
      ],
      "start_s": 26.2,
      "end_s": 27.0
    },
    {
      "id": "ad_12",
      "text": "卡清关、追踪男，全被一脚踹飞。",
      "voice": "Ethan",
      "mode": "narration",
      "segment_ids": [
        "seg_8"
      ],
      "start_s": 28.0,
      "end_s": 31.0
    },
    {
      "id": "ad_13",
      "text": "最后一个也拦不住——阿宝抱住对手，一路翻滚送到底！",
      "voice": "Ethan",
      "mode": "narration",
      "segment_ids": [
        "seg_9"
      ],
      "start_s": 32.2,
      "end_s": 37.4
    },
    {
      "id": "ad_14",
      "text": "顺丰国际，全球达！",
      "voice": "Ethan",
      "mode": "dialogue",
      "speaker": {
        "window_id": "window_0cdd0a77e6fb1dd8",
        "role_id": "B"
      },
      "segment_ids": [
        "seg_10"
      ],
      "start_s": 39.4,
      "end_s": 41.4
    },
    {
      "id": "ad_15",
      "text": "您的跨境包裹，有我们守护。",
      "voice": "Cherry",
      "mode": "dialogue",
      "speaker": {
        "window_id": "window_0cdd0a77e6fb1dd8",
        "role_id": "A"
      },
      "segment_ids": [
        "seg_10"
      ],
      "start_s": 41.8,
      "end_s": 43.8
    },
    {
      "id": "ad_16",
      "text": "一单不落！",
      "voice": "Ethan",
      "mode": "dialogue",
      "speaker": {
        "window_id": "window_0cdd0a77e6fb1dd8",
        "role_id": "B"
      },
      "segment_ids": [
        "seg_10"
      ],
      "start_s": 44.2,
      "end_s": 45.2
    }
  ],

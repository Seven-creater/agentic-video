        "audio_draft": [
          {
            "id": "line_1",
            "text": "这条街的生意火到什么程度？订单像雪片一样，一张接一张往店里飞。",
            "voice": "Moon",
            "mode": "narration",
            "start_s": 0.0,
            "end_s": 6.24
          },
          {
            "id": "line_2",
            "text": "老板，明天的单子都排到三百桌了，咱们到底接不接？",
            "voice": "Cherry",
            "mode": "dialogue",
            "start_s": 7.0,
            "end_s": 11.559999999999999
          },
          {
            "id": "line_3",
            "text": "不接。一天最多三十桌，一桌都不能多。",
            "voice": "Ethan",
            "mode": "dialogue",
            "start_s": 12.5,
            "end_s": 15.86
          },
          {
            "id": "line_4",
            "text": "放着三百桌不接，您这钱都不想赚了？",
            "voice": "Cherry",
            "mode": "dialogue",
            "start_s": 15.86,
            "end_s": 18.98
          },
          {
            "id": "line_5",
            "text": "宁可少赚，也不能坏了规矩。",
            "voice": "Ethan",
            "mode": "dialogue",
            "start_s": 19.5,
            "end_s": 21.82
          },
          {
            "id": "line_6",
            "text": "规矩立住了，路才越走越宽。别急，一步一步来，把每碗的分量都做扎实。",
            "voice": "Ethan",
            "mode": "dialogue",
            "start_s": 23.5,
            "end_s": 30.54
          },
          {
            "id": "line_7",
            "text": "不亏钱事小，亏人心事大。守住规矩的店，客人自己会找上门来。",
            "voice": "Moon",
            "mode": "narration",
            "start_s": 31.5,
            "end_s": 39.74
          },
          {
            "id": "line_8",
            "text": "守住规矩，才守得住人心。",
            "voice": "Ethan",
            "mode": "dialogue",
            "start_s": 40.5,
            "end_s": 43.06
          }
        ]

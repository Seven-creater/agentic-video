  "audio_draft": [
    {
      "id": "ad_1",
      "text": "藏了多年的私账，终于被翻了出来。",
      "voice": "Ethan",
      "mode": "narration",
      "segment_ids": [
        "seg_1"
      ]
    },
    {
      "id": "ad_2",
      "text": "这些东西，你一样都不敢用？",
      "voice": "Ethan",
      "mode": "dialogue",
      "speaker": {
        "window_id": "window_5d4adb563173c73f",
        "role_id": "candidate_B"
      },
      "segment_ids": [
        "seg_1",
        "seg_2",
        "seg_3"
      ],
      "identity_anchor_segment_id": "seg_1"
    },
    {
      "id": "ad_3",
      "text": "大人冤枉……我一分都不敢动啊。",
      "voice": "Moon",
      "mode": "dialogue",
      "speaker": {
        "window_id": "window_5d4adb563173c73f",
        "role_id": "ram_seer"
      },
      "segment_ids": [
        "seg_4"
      ],
      "identity_anchor_segment_id": "seg_4"
    },
    {
      "id": "ad_4",
      "text": "不敢动？还是舍不得动？",
      "voice": "Ethan",
      "mode": "dialogue",
      "speaker": {
        "window_id": "window_5d4adb563173c73f",
        "role_id": "candidate_B"
      },
      "segment_ids": [
        "seg_5"
      ],
      "identity_anchor_segment_id": "seg_1"
    },
    {
      "id": "ad_5",
      "text": "全都在这儿……一件都没少……",
      "voice": "Moon",
      "mode": "dialogue",
      "speaker": {
        "window_id": "window_ad301080fad7d8a2",
        "role_id": "ram_seer"
      },
      "segment_ids": [
        "seg_6"
      ],
      "identity_anchor_segment_id": "seg_4"
    },
    {
      "id": "ad_6",
      "text": "装穷给谁看？",
      "voice": "Ethan",
      "mode": "dialogue",
      "speaker": {
        "window_id": "window_ad301080fad7d8a2",
        "role_id": "candidate_B"
      },
      "segment_ids": [
        "seg_7"
      ],
      "identity_anchor_segment_id": "seg_7"
    },
    {
      "id": "ad_7",
      "text": "你也一样？",
      "voice": "Cherry",
      "mode": "dialogue",
      "speaker": {
        "window_id": "window_f6f4dd0754192761",
        "role_id": "cand_panda"
      },
      "segment_ids": [
        "seg_8"
      ],
      "identity_anchor_segment_id": "seg_8"
    },
    {
      "id": "ad_8",
      "text": "我……一分都不敢花……",
      "voice": "Serena",
      "mode": "dialogue",
      "speaker": {
        "window_id": "window_f6f4dd0754192761",
        "role_id": "cand_small_master"
      },
      "segment_ids": [
        "seg_9"
      ],
      "identity_anchor_segment_id": "seg_9"
    },
    {
      "id": "ad_9",
      "text": "贪来的钱，一分不敢花。",
      "voice": "Moon",
      "mode": "narration",
      "segment_ids": [
        "seg_10"
      ]
    },
    {
      "id": "ad_10",
      "text": "囤着不敢动的东西，恰恰是罪名本身。",
      "voice": "Moon",
      "mode": "narration",
      "segment_ids": [
        "seg_10"
      ]

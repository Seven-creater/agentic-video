      "audio_path": "/home/ubuntu/apps/agentic-video/shared/jobs/sb_20_赵德汉藏钱_11010204/evaluations/theme1/evaluations/film1/evaluations/film2/rough_audio/tts/utt_011978c94c0ccd6b325f/audio.normalized.wav",

        },
        {
          "segment_id": "seg_2",
          "relation": "narration"
        }
      ],
      "start_s": 2.0,
      "end_s": 6.08
    },
    {
      "id": "line_2",
      "text": "一分不敢花。",
      "voice": "Serena",
      "mode": "dialogue",
      "speaker": {
        "window_id": "window_4d0e75ebd00631d2",
        "role_id": "weeping_student"

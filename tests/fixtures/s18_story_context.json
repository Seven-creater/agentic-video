  "audio_draft": [
    {
      "id": "line_1",
      "text": "被人掀开老底，他先是一愣，随即装出一脸无辜。",
      "voice": "Moon",
      "mode": "narration",
      "segment_ids": [
        "seg_1",
        "seg_2"
      ],
      "audio_relation": [

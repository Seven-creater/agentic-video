        }
      ],
      "start_s": 0.0,
      "end_s": 2.0
    },
    {
      "id": "line_3",
      "text": "人前装清廉，人后偷偷得意。",
      "voice": "Cherry",
      "mode": "narration",
      "segment_ids": [
        "seg_3"
      ],
      "audio_relation": [
        {
          "segment_id": "seg_3",
          "relation": "cutaway"
        }
      ],
      "start_s": 18.0,
      "end_s": 20.8
    },
    {
      "id": "line_4",
      "text": "面对质问，他先是抵赖，把话岔开。",
      "voice": "Moon",
      "mode": "narration",
      "segment_ids": [
        "seg_4"
      ],
      "audio_relation": [
        {
          "segment_id": "seg_4",
          "relation": "narration"
        }
      ],
      "start_s": 22.32,
      "end_s": 26.08
    },
    {
      "id": "line_5",
      "text": "这些东西，你敢花吗。",
      "voice": "Ethan",
      "mode": "dialogue",
      "speaker": {
        "window_id": "window_4d0e75ebd00631d2",
        "role_id": "old_master"
      },
      "segment_ids": [
        "seg_5"
      ],
      "audio_relation": [
        {
          "segment_id": "seg_5",
          "relation": "on_screen"
        }
      ],
      "start_s": 41.0,
      "end_s": 43.16
    },
    {
      "id": "line_6",
      "text": "纸包不住火，证据被摆到眼前，他只剩崩溃这一条路。",
      "voice": "Moon",
      "mode": "narration",
      "segment_ids": [
        "seg_6",
        "seg_7"
      ],
      "audio_relation": [
        {
          "segment_id": "seg_6",
          "relation": "reaction"
        },
        {
          "segment_id": "seg_7",
          "relation": "narration"
        }

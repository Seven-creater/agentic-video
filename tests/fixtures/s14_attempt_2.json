  "audio_draft": [
    {
      "id": "n1",
      "text": "雪夜，他把保温箱留给了狐狸。",
      "voice": "Ethan",
      "mode": "narration",
      "segment_ids": [
        "seg1"
      ]
    },
    {
      "id": "d1",
      "text": "这箱子给你保暖。",
      "voice": "Ethan",
      "mode": "dialogue",
      "segment_ids": [
        "seg1"
      ],
      "speaker": {
        "window_id": "window_5297a7078d6f1d1a",
        "role_id": "A"
      }
    },
    {
      "id": "d2",
      "text": "希望能熬过这个冬天。",
      "voice": "Ethan",
      "mode": "dialogue",
      "segment_ids": [
        "seg1"
      ],
      "speaker": {
        "window_id": "window_5297a7078d6f1d1a",
        "role_id": "A"
      }
    },
    {
      "id": "d3",
      "text": "你救过一只狐狸吗？",
      "voice": "Serena",
      "mode": "dialogue",
      "segment_ids": [
        "seg_crane1"
      ],
      "speaker": {
        "window_id": "window_b348ffed60a55772",
        "role_id": "A"
      }
    },
    {
      "id": "d4",
      "text": "你是那只狐狸吗？",
      "voice": "Ethan",
      "mode": "dialogue",
      "segment_ids": [
        "seg2"
      ],
      "speaker": {
        "window_id": "window_620712b2e4e1b507",
        "role_id": "A"
      }
    },
    {
      "id": "d5",
      "text": "还是幕后策划？",
      "voice": "Ethan",
      "mode": "dialogue",
      "segment_ids": [
        "seg2"
      ],
      "speaker": {
        "window_id": "window_620712b2e4e1b507",
        "role_id": "A"
      }
    },
    {
      "id": "d6",
      "text": "还是快递盒？",
      "voice": "Ethan",
      "mode": "dialogue",
      "segment_ids": [
        "seg4"
      ],
      "speaker": {
        "window_id": "window_a4d1fc75deb993c0",
        "role_id": "A"
      }
    },
    {
      "id": "d7",
      "text": "还是导演？",
      "voice": "Ethan",
      "mode": "dialogue",
      "segment_ids": [
        "seg4"
      ],
      "speaker": {
        "window_id": "window_a4d1fc75deb993c0",
        "role_id": "A"
      }
    },
    {
      "id": "n2",
      "text": "白鹤一一摇头，都不是。",
      "voice": "Serena",
      "mode": "narration",
      "segment_ids": [
        "seg5"
      ]
    },
    {
      "id": "d8",
      "text": "都不是。",
      "voice": "Serena",
      "mode": "dialogue",
      "segment_ids": [
        "seg_crane2"
      ],
      "speaker": {
        "window_id": "window_b348ffed60a55772",
        "role_id": "A"
      }
    },
    {
      "id": "d9",
      "text": "我是顺丰使者",
      "voice": "Ethan",
      "mode": "dialogue",
      "segment_ids": [
        "seg6"
      ],
      "speaker": {
        "window_id": "window_73a5a4017e928063",
        "role_id": "A"
      }
    },
    {
      "id": "d10",
      "text": "跟我送快递",
      "voice": "Ethan",
      "mode": "dialogue",
      "segment_ids": [
        "seg6"
      ],
      "speaker": {
        "window_id": "window_73a5a4017e928063",
        "role_id": "A"
      }
    },
    {
      "id": "d12",
      "text": "我是时效慢。",
      "voice": "Moon",
      "mode": "dialogue",
      "segment_ids": [
        "seg7"
      ],
      "speaker": {
        "window_id": "window_981ab0fbb293f110",
        "role_id": "S"
      }
    },
    {
      "id": "d13",
      "text": "我是卡清关。",
      "voice": "Moon",
      "mode": "dialogue",
      "segment_ids": [
        "seg7"
      ],
      "speaker": {
        "window_id": "window_981ab0fbb293f110",
        "role_id": "S"
      }
    },
    {
      "id": "d14",
      "text": "怕了吗？",
      "voice": "Moon",
      "mode": "dialogue",
      "segment_ids": [
        "seg7"
      ],
      "speaker": {
        "window_id": "window_981ab0fbb293f110",
        "role_id": "S"
      }
    },
    {
      "id": "d15",
      "text": "那就比比速度！",
      "voice": "Ethan",
      "mode": "dialogue",
      "segment_ids": [
        "seg8"
      ],
      "speaker": {
        "window_id": "window_981ab0fbb293f110",
        "role_id": "P"
      }
    },
    {
      "id": "n3",
      "text": "追踪难也带着手下堵住了去路。",
      "voice": "Ethan",
      "mode": "narration",
      "segment_ids": [
        "seg9"
      ]
    },
    {
      "id": "d16",
      "text": "一个都别想过去！",
      "voice": "Ethan",
      "mode": "dialogue",
      "segment_ids": [
        "seg9"
      ],
      "speaker": {
        "window_id": "window_a536131ff01d9a61",
        "role_id": "B"
      }
    },
    {
      "id": "d17",
      "text": "包裹到手了！",
      "voice": "Ethan",
      "mode": "dialogue",
      "segment_ids": [
        "seg10"
      ],
      "speaker": {
        "window_id": "window_10e9d6cfdef7e508",
        "role_id": "A"
      }
    },
    {
      "id": "d18",
      "text": "快走！",
      "voice": "Cherry",
      "mode": "dialogue",
      "segment_ids": [
        "seg10"
      ],
      "speaker": {
        "window_id": "window_10e9d6cfdef7e508",
        "role_id": "B"
      }
    },
    {
      "id": "d19",
      "text": "时效慢他们追不上了",
      "voice": "Ethan",
      "mode": "dialogue",
      "segment_ids": [
        "seg10"
      ],
      "speaker": {
        "window_id": "window_10e9d6cfdef7e508",
        "role_id": "A"
      }
    },
    {

  "audio_draft": [
    {
      "id": "line_1",
      "text": "小面馆的傍晚，徒弟还在灶台前忙着张罗生意。",
      "voice": "Moon",
      "mode": "narration",
      "segment_ids": [
        "seg_1"
      ],
      "start_s": 0.5,
      "end_s": 4.5
    },
    {
      "id": "line_2",
      "text": "老板，明天能订三百桌吗？",
      "voice": "Cherry",
      "mode": "dialogue",
      "speaker": {
        "window_id": "window_14d50aa7d97821ce",
        "role_id": "ping_goose"
      },
      "segment_ids": [
        "seg_2"
      ],
      "start_s": 6.2,
      "end_s": 8.8
    },
    {
      "id": "line_3",
      "text": "不接，一天最多三十桌。",
      "voice": "Ethan",
      "mode": "dialogue",
      "speaker": {
        "window_id": "window_1e5c684349b6b213",
        "role_id": "po_panda"
      },
      "segment_ids": [
        "seg_3"
      ],
      "start_s": 9.3,
      "end_s": 12.3
    },
    {
      "id": "line_4",
      "text": "宁可少赚，也不能坏了规矩，路才越走越宽。",
      "voice": "Ethan",
      "mode": "dialogue",
      "speaker": {
        "window_id": "window_decd72f144e87d26",
        "role_id": "po_panda"
      },
      "segment_ids": [
        "seg_4"
      ],
      "start_s": 13.3,
      "end_s": 17.8
    },
    {
      "id": "line_5",
      "text": "啊？",
      "voice": "Cherry",
      "mode": "dialogue",
      "speaker": {
        "window_id": "window_decd72f144e87d26",
        "role_id": "ping_goose"
      },
      "segment_ids": [
        "seg_5"
      ],
      "start_s": 18.2,
      "end_s": 19.0
    },
    {
      "id": "line_6",
      "text": "去进一批一百六十八以上的美蛙鱼。记住，一百六十八是底线。",
      "voice": "Ethan",
      "mode": "dialogue",
      "speaker": {
        "window_id": "window_6deec76d245c60ad",
        "role_id": "A"
      },
      "segment_ids": [
        "seg_6"
      ],
      "start_s": 19.2,
      "end_s": 23.9
    },
    {
      "id": "line_7",
      "text": "成本这么高，不怕亏钱吗？",
      "voice": "Cherry",
      "mode": "dialogue",
      "speaker": {
        "window_id": "window_14d50aa7d97821ce",
        "role_id": "ping_goose"
      },
      "segment_ids": [
        "seg_7"
      ],
      "start_s": 24.1,
      "end_s": 26.2
    },
    {
      "id": "line_8",
      "text": "怕，但更怕亏掉人心。",
      "voice": "Ethan",
      "mode": "dialogue",
      "speaker": {
        "window_id": "window_b068c254cdc29902",
        "role_id": "A"
      },
      "segment_ids": [
        "seg_8"
      ],
      "start_s": 26.4,
      "end_s": 29.0
    },
    {
      "id": "line_9",
      "text": "守好这条底线，顾客吃了不烧心。",
      "voice": "Ethan",
      "mode": "dialogue",
      "speaker": {
        "window_id": "window_7360119fed755b9c",
        "role_id": "po_panda"
      },
      "segment_ids": [
        "seg_9"
      ],
      "start_s": 29.5,
      "end_s": 32.5
    },
    {
      "id": "line_10",
      "text": "守住人心，路才越走越宽。",
      "voice": "Moon",
      "mode": "narration",
      "segment_ids": [
        "seg_9"
      ],
      "start_s": 33.0,
      "end_s": 36.0
    }

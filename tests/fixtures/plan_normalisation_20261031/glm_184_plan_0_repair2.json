  "audio_draft": [
    {
      "id": "line_1",
      "text": "老板，明天能订三百桌吗？",
      "voice": "Cherry",
      "mode": "dialogue",
      "speaker": {
        "window_id": "window_decd72f144e87d26",
        "role_id": "ping_goose"
      },
      "segment_ids": [
        "seg_1"
      ],
      "start_s": 0.2,
      "end_s": 2.6
    },
    {
      "id": "line_2",
      "text": "不接，一天最多三十桌，宁可少赚也不能坏了规矩。",
      "voice": "Ethan",
      "mode": "dialogue",
      "speaker": {
        "window_id": "window_1e5c684349b6b213",
        "role_id": "po_panda"
      },
      "segment_ids": [
        "seg_2",
        "seg_3"
      ],
      "start_s": 5.1,
      "end_s": 9.9
    },
    {
      "id": "line_3",
      "text": "进一批一百六十八以上的鱼，一百六十八是底线。",
      "voice": "Ethan",
      "mode": "dialogue",
      "speaker": {
        "window_id": "window_6deec76d245c60ad",
        "role_id": "A"
      },
      "segment_ids": [
        "seg_4"
      ],
      "start_s": 10.2,
      "end_s": 14.6
    },
    {
      "id": "line_4",
      "text": "不怕亏钱吗？",
      "voice": "Cherry",
      "mode": "dialogue",
      "speaker": {
        "window_id": "window_1e5c684349b6b213",
        "role_id": "ping_goose"
      },
      "segment_ids": [
        "seg_5"
      ],
      "start_s": 15.05,
      "end_s": 15.95
    },
    {
      "id": "line_5",
      "text": "怕，但更怕亏掉人心。",
      "voice": "Ethan",
      "mode": "dialogue",
      "speaker": {
        "window_id": "window_1e5c684349b6b213",
        "role_id": "po_panda"
      },
      "segment_ids": [
        "seg_6"
      ],
      "start_s": 16.2,
      "end_s": 18.4
    },
    {
      "id": "line_6",
      "text": "不烧心，路才越走越宽。",

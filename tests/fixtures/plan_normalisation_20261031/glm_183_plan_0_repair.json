  "audio_draft": [
    {
      "id": "line_1",
      "text": "面馆柜台前，老板正核对菜单。",
      "voice": "Moon",
      "mode": "narration",
      "segment_ids": [
        "seg_1"
      ],
      "start_s": 0.1,
      "end_s": 2.2
    },
    {
      "id": "line_2",
      "text": "老板，明天能订三百桌吗？",
      "voice": "Cherry",
      "mode": "dialogue",
      "speaker": {
        "window_id": "ref_movie",
        "role_id": "apprentice"
      },
      "segment_ids": [
        "seg_2"
      ],
      "start_s": 2.4,
      "end_s": 4.0
    },
    {
      "id": "line_3",
      "text": "不接，一天最多三十桌。",
      "voice": "Ethan",
      "mode": "dialogue",
      "speaker": {
        "window_id": "ref_movie",
        "role_id": "boss"
      },
      "segment_ids": [
        "seg_2"
      ],
      "start_s": 4.1,
      "end_s": 5.1
    },
    {
      "id": "line_4",
      "text": "宁可少赚，也不能坏了规矩。",
      "voice": "Ethan",
      "mode": "dialogue",
      "speaker": {
        "window_id": "ref_movie",
        "role_id": "boss"
      },
      "segment_ids": [
        "seg_3"
      ],
      "start_s": 5.3,
      "end_s": 7.1
    },
    {
      "id": "line_5",
      "text": "他吩咐徒弟去备货。",
      "voice": "Moon",
      "mode": "narration",
      "segment_ids": [
        "seg_4"
      ],
      "start_s": 15.0,
      "end_s": 16.4
    },
    {
      "id": "line_6",
      "text": "进一批一百六十八以上的鱼，一百六十八是底线。",
      "voice": "Ethan",
      "mode": "dialogue",
      "speaker": {
        "window_id": "ref_movie",
        "role_id": "boss"
      },
      "segment_ids": [
        "seg_5"
      ],
      "start_s": 16.6,
      "end_s": 20.4
    },
    {
      "id": "line_7",
      "text": "成本这么高，不怕亏钱吗？",
      "voice": "Cherry",
      "mode": "dialogue",
      "speaker": {
        "window_id": "ref_movie",
        "role_id": "apprentice"
      },
      "segment_ids": [
        "seg_6"
      ],
      "start_s": 22.2,
      "end_s": 24.0
    },
    {
      "id": "line_8",
      "text": "怕，但更怕亏掉人心。",
      "voice": "Ethan",
      "mode": "dialogue",
      "speaker": {
        "window_id": "ref_movie",
        "role_id": "boss"
      },
      "segment_ids": [
        "seg_6"
      ],
      "start_s": 24.3,
      "end_s": 26.0
    },
    {
      "id": "line_9",
      "text": "守好底线，顾客吃了不烧心，路才越走越宽。",
      "voice": "Ethan",
      "mode": "dialogue",
      "speaker": {
        "window_id": "ref_movie",
        "role_id": "boss"
      },
      "segment_ids": [
        "seg_7"
      ],
      "start_s": 29.5,
      "end_s": 33.0
    }
  ],
